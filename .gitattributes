# Keep line endings predictable across machines (Windows clones default to core.autocrlf=true).

# Data files: always LF, byte-identical to what the loaders and the ML training expect.
*.csv   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf

# PowerShell scripts: CRLF, the native Windows format.
*.ps1   text eol=crlf

# Binary assets: never touch.
*.mp4     binary
*.jpeg    binary
*.jpg     binary
*.png     binary
*.joblib  binary
*.graphml binary
